{
  "openapi": "3.0.0",
  "info": {
    "title": "Odyssey Restaurant API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "sortOrder",
          "createdAt"
        ]
      },
      "MenuItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "priceCents": {
            "type": "integer"
          },
          "available": {
            "type": "boolean"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "categoryId",
          "name",
          "description",
          "priceCents",
          "available",
          "imageUrl",
          "createdAt"
        ]
      },
      "CreateMenuItem": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "available": {
            "type": "boolean"
          },
          "imageUrl": {
            "type": "string"
          }
        },
        "required": [
          "categoryId",
          "name",
          "priceCents"
        ]
      },
      "UpdateMenuItem": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "available": {
            "type": "boolean"
          },
          "imageUrl": {
            "type": "string"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "preparing",
              "ready",
              "completed",
              "cancelled"
            ]
          },
          "totalCents": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "customerId",
          "status",
          "totalCents",
          "createdAt",
          "updatedAt"
        ]
      },
      "OrderDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Order"
          },
          {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "menuItemId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "nameSnapshot": {
                      "type": "string"
                    },
                    "unitPriceCents": {
                      "type": "integer"
                    },
                    "quantity": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "menuItemId",
                    "nameSnapshot",
                    "unitPriceCents",
                    "quantity"
                  ]
                }
              }
            },
            "required": [
              "items"
            ]
          }
        ]
      },
      "CreateOrder": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "menuItemId": {
                  "type": "string",
                  "format": "uuid"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 0,
                  "exclusiveMinimum": true
                }
              },
              "required": [
                "menuItemId",
                "quantity"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "customerId",
          "items"
        ]
      },
      "UpdateOrderStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "preparing",
              "ready",
              "completed",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CustomerWithStats": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "orderCount": {
            "type": "integer"
          },
          "totalSpentCents": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "phone",
          "orderCount",
          "totalSpentCents"
        ]
      },
      "CustomerDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CustomerWithStats"
          },
          {
            "type": "object",
            "properties": {
              "recentOrders": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string"
                    },
                    "totalCents": {
                      "type": "integer"
                    },
                    "createdAt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "status",
                    "totalCents",
                    "createdAt"
                  ]
                }
              }
            },
            "required": [
              "recentOrders"
            ]
          }
        ]
      },
      "Settings": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "prepTimeMinutes": {
            "type": "integer"
          },
          "autoAccept": {
            "type": "boolean"
          },
          "acceptingOrders": {
            "type": "boolean"
          },
          "openingHours": {
            "nullable": true
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "prepTimeMinutes",
          "autoAccept",
          "acceptingOrders",
          "updatedAt"
        ]
      },
      "UpdateSettings": {
        "type": "object",
        "properties": {
          "prepTimeMinutes": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "autoAccept": {
            "type": "boolean"
          },
          "acceptingOrders": {
            "type": "boolean"
          },
          "openingHours": {
            "nullable": true
          }
        }
      },
      "PopularItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "orderCount": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "priceCents",
          "imageUrl",
          "orderCount"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/categories": {
      "get": {
        "tags": [
          "Menu"
        ],
        "summary": "Lister les catégories du menu",
        "responses": {
          "200": {
            "description": "Catégories triées par ordre d'affichage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/menu-items": {
      "get": {
        "tags": [
          "Menu"
        ],
        "summary": "Lister les plats actifs",
        "responses": {
          "200": {
            "description": "Plats non archivés",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MenuItem"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Menu"
        ],
        "summary": "Créer un plat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMenuItem"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Plat créé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            }
          }
        }
      }
    },
    "/menu-items/{id}": {
      "patch": {
        "tags": [
          "Menu"
        ],
        "summary": "Modifier un plat",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMenuItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Plat modifié",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            }
          },
          "404": {
            "description": "Plat introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Menu"
        ],
        "summary": "Archiver un plat (soft delete)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Plat archivé",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "success"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Plat introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Lister les commandes",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "accepted",
                "preparing",
                "ready",
                "completed",
                "cancelled"
              ]
            },
            "required": false,
            "name": "status",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des commandes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Créer une commande",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrder"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Commande créée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Payload invalide",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Détail d'une commande",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Détail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetail"
                }
              }
            }
          },
          "404": {
            "description": "Introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}/status": {
      "patch": {
        "tags": [
          "Orders"
        ],
        "summary": "Changer le statut d'une commande",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrderStatus"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Statut mis à jour",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Transition invalide",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/customers": {
      "get": {
        "tags": [
          "CRM"
        ],
        "summary": "Lister les clients avec statistiques",
        "responses": {
          "200": {
            "description": "Clients + stats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CustomerWithStats"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "tags": [
          "CRM"
        ],
        "summary": "Détail d'un client avec commandes récentes",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Détail client",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerDetail"
                }
              }
            }
          },
          "404": {
            "description": "Introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/settings": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Lire les réglages",
        "responses": {
          "200": {
            "description": "Réglages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "404": {
            "description": "Aucun réglage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Settings"
        ],
        "summary": "Mettre à jour les réglages",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSettings"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Réglages mis à jour",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "404": {
            "description": "Aucun réglage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/stats/popular-items": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "Plats les plus commandés",
        "responses": {
          "200": {
            "description": "Top plats par quantité commandée",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PopularItem"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}